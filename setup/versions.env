# Pinned versions, taken from the primary (macOS) machine.
# Bump these to upgrade every machine; re-running install.sh picks up the change.

CHEZMOI_VERSION="2.70.5"
PYENV_VERSION="2.7.3"
PYTHON_VERSION="3.13.7"
NEOVIM_VERSION="0.12.4"
TMUX_VERSION="3.7b"

# Needed by the neovim config (mason servers, treesitter, markdown-preview, quarto)
NODE_VERSION="26.4.0"
GO_VERSION="1.26.4"
TREE_SITTER_VERSION="0.25.10"
QUARTO_VERSION="1.9.38"

JUST_VERSION="1.58.0"
BAZELISK_VERSION="1.29.0" # installed as `bazel`; repos pick bazel itself via .bazelversion
# cmake and homebrew aren't pinned: cmake tracks Kitware's apt repo, brew self-updates.

# GUI
KITTY_VERSION="0.43.1"
GHOSTTY_VERSION="1.3.1"
GHOSTTY_DEB_TAG="1.3.1-0-ppa2" # release tag in github.com/mkasberg/ghostty-ubuntu
NERD_FONT="JetBrainsMono"
